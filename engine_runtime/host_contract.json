{
  "version": "1.0",
  "priority_invariants": [
    {"id": "P0-1", "rule": "数据库是唯一真相", "enforcement": "SQLite事件账本 > YAML > 小说文本"},
    {"id": "P0-2", "rule": "玩家选项只能执行预保存合同", "enforcement": "execute_player_choice 读取 pending_options"},
    {"id": "P0-3", "rule": "玩家提交行动就是授权，不二次确认", "enforcement": "execute_host_action 内部预览后立即提交"},
    {"id": "P0-4", "rule": "非法选项不能展示", "enforcement": "compile_options 丢弃 preview.legal==False"},
    {"id": "P0-5", "rule": "玩家不能看到内部主持信息", "enforcement": "player_facing_result 剥离引擎字段"}
  ],
  "turn_workflow": {
    "entry_point": "python tools/game_turn.py",
    "steps": [
      "加载存档",
      "执行玩家行动（选项合同或自由输入JSON）",
      "记录叙事日志",
      "自动生成下一回合候选",
      "编译选项（合法性门槛）",
      "返回 NarrativePackage"
    ],
    "llm_responsibility": "只负责：解析自由输入为行动JSON + 把NarrativePackage写成小说",
    "python_responsibility": "执行、校验、选项生成、状态更新、审计"
  },
  "forbidden_player_visible_terms": [
    "预览合法", "未结算", "Python", "SQLite", "dry-run",
    "action_id", "确认执行", "compile_options", "preview"
  ],
  "player_choice_requires_pending_contract": true,
  "allow_second_confirmation": false,
  "visible_options_require_prevalidation": true,
  "forbid_direct_save_edits": true,
  "narrative_length_formula": "narrative_length × 100~120 字",
  "option_format": {
    "structure": "A/B/C + 自由行动D",
    "source": "meta.pending_options（Python编译）",
    "never": "LLM凭叙事直觉直接写出"
  }
}
