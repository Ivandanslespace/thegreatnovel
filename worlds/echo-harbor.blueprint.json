{
  "schemaVersion": 1,
  "meta": {
    "name": "echo-harbor",
    "title": "回声潮港",
    "prompt": "我想进入一个靠潮汐贸易运转的港口世界，记忆与账目是可以交易的东西",
    "seed": 20260803,
    "controlAxis": "知识/记忆"
  },
  "designCheck": {
    "controlGap": "开局主角是无凭据的外来者：没有行会资格，只能打零工，生计余裕每回合流逝，不知道潮汐窗口何时开启、账簿凭什么借出——控制缺口同时是物质（生计）与信息（规律）两层。",
    "legibleRule": "三条潮汐规律对所有人一致且可观察：退潮窗口（回合3-4、8-9）装卸与小额贸易机会开启；大潮（回合5-6、10-11）货价剧震风险与收益同增；账簿互惠（账簿认因果不认人）。玩家通过观察、请教与打听逐步看懂并改变决定。",
    "leverageConversion": "回声账簿改变两条转化：1) 退潮/大潮窗口内的抽签权重向主角倾斜（同一次机会对主角可执行性与成功率不同）；2) 解锁独占行动'预知货价窗口'与'锚定一次风险'，把洞察直接兑换为时机信息与风险下限。代价是每次借用消耗因果洞察，洞察必须靠观察/调查挣得。普通人没有多年残账复原训练，读不出潮因链，故难以复制。",
    "compounding": "洞察→借账簿→更好的窗口判断→更多凭据与洞察→抄录账簿/供奉档案提升档案好感→触及更高层行动（行会谈判、潮汐契约、外锚航线）。阶层1'账簿之客'解锁回声岛与新收入行动；旧成果（洞察、好感、凭据）全部保留为阶层2的起点。",
    "opportunityCost": "时间是硬约束：打工维持生计就无暇观察；借账簿消耗洞察就推迟阶层门槛积累；预知与锚定互抢洞察储备；行会在回合7对高收入无凭据者抽'潮税'。错过大潮窗口要等5回合。永久损失来自世界因果（生计归零被逐出港），不是系统删除。",
    "worldFeedback": "三势力的离屏推进都接有机械后果：码头互助会回合4慢工谈判（dock-slowdown 期间零工顺手率下降）；行会回合6挤压外乡人（guild-squeeze 压低小额贸易的顺手权重）并回合7对高收入无凭据者抽潮税；档案守护者在洞察≥3时主动注意到主角。税日回合9扣生计。status 只投影玩家已知事实与可见来源的 flag，秘密（行会底细等）须经行动获得。",
    "portability": "引擎只解释资产/条件/抽签/窗口/计划表等原语，本世界的'潮汐窗口+账簿'全部是数据。换一个结构不同的世界（如关系杠杆或生产杠杆），只需新 Blueprint，引擎与体验原则不变。"
  },
  "laws": [
    {
      "id": "law-ebb-flow",
      "description": "退潮窗口：退潮时货船集中靠泊，装卸与小额贸易的短窗口开启（回合 3–4、8–9）。",
      "trigger": { "or": [{ "window": { "gte": 3, "lte": 4 } }, { "window": { "gte": 8, "lte": 9 } }] },
      "effect": [{ "setFlag": "tide-ebb" }]
    },
    {
      "id": "law-spring-tide",
      "description": "大潮规律：大潮期货价剧震，贸易的风险与收益同时放大（回合 5–6、10–11）。",
      "trigger": { "or": [{ "window": { "gte": 5, "lte": 6 } }, { "window": { "gte": 10, "lte": 11 } }] },
